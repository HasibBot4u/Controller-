rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User-scoped project metadata (Authoritative writes occur exclusively via backend server SDK)
    match /users/{userId}/projects/{projectId} {
      allow get, list: if isOwner(userId);
      allow write: if false;
    }

    // User-scoped activity tracks (Authoritative writes occur exclusively via backend server SDK)
    match /users/{userId}/activities/{activityId} {
      allow get, list: if isOwner(userId);
      allow write: if false;
    }

    // User-scoped approval requests (Approvals are server-authoritative; no client-side status mutation)
    match /users/{userId}/approvals/{approvalId} {
      allow get, list: if isOwner(userId);
      allow write: if false;
    }

    // User-scoped checkpoints
    match /users/{userId}/checkpoints/{checkpointId} {
      allow get, list: if isOwner(userId);
      allow write: if false;
    }

    // User-scoped sessions
    match /users/{userId}/sessions/{sessionId} {
      allow get, list: if isOwner(userId);
      allow write: if false;
    }

    // System connection check path for connectivity test
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
