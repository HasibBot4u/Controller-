rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User-scoped project workspace metadata
    match /users/{userId}/projects/{projectId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(projectId)
        && request.resource.data.keys().hasAll(['id', 'name', 'ownerId', 'updatedAt', 'status'])
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(userId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(userId);
    }

    // User-scoped activity tracks
    match /users/{userId}/activities/{activityId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(activityId)
        && request.resource.data.keys().hasAll(['id', 'projectId', 'title', 'status', 'ownerId', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(userId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(userId);
    }

    // User-scoped approval requests
    match /users/{userId}/approvals/{approvalId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(approvalId)
        && request.resource.data.keys().hasAll(['id', 'actionType', 'riskLevel', 'title', 'status', 'requestedAt']);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // System connection check path for testConnection
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
